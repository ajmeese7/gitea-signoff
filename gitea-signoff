#!/usr/bin/env bash
set -euo pipefail

VERSION=0.2.0
readonly SYM_SUCCESS=$'✓'
readonly SYM_PENDING=$'⟳'
readonly SYM_FAILURE=$'✗'
HOST="${GITEA_SIGNOFF_HOST:-}"
USER_NAME="${GITEA_SIGNOFF_USER:-}"
REPO="${GITEA_SIGNOFF_REPO:-}"

die() { echo "gitea-signoff: $*" >&2; exit 1; }
resolve_context() { if [ -n "${1:-}" ]; then echo "signoff/$1"; else echo signoff; fi; }
state_symbol() {
  case "$1" in
    success) echo "$SYM_SUCCESS" ;;
    pending) echo "$SYM_PENDING" ;;
    *) echo "$SYM_FAILURE" ;;
  esac
}
is_signoff_context() { case "$1" in signoff|signoff/*) return 0 ;; *) return 1 ;; esac; }
api() {
  local flags=(--no-input)
  [ -z "$HOST" ] || flags+=(--host "$HOST")
  [ -z "$USER_NAME" ] || flags+=(--user "$USER_NAME")
  [ -z "$REPO" ] || flags+=(--repo "$REPO")
  GITEA_CLI_ERROR_FORMAT=json gt "${flags[@]}" api "$@"
}
require_tools() {
  command -v gt >/dev/null || die "gt is required: https://gitea.com/gitea/cli"
  command -v jq >/dev/null || die "jq is required"
  git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
}
pin_repository() {
  REPO="$(api 'repos/{owner}/{repo}' | jq -er '.html_url | strings | select(length > 0)')"
}
default_branch() { api 'repos/{owner}/{repo}' | jq -er '.default_branch | strings | select(length > 0)'; }
branch_path() { jq -nr --arg branch "$1" '$branch | @uri'; }
protection() {
  local error_file result rc=0
  error_file="$(mktemp)"
  result="$(api "repos/{owner}/{repo}/branch_protections/$(branch_path "$1")" 2>"$error_file")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    if jq -e '.error.status == 404' "$error_file" >/dev/null 2>&1; then
      rm -f "$error_file"
      echo null
      return
    fi
    cat "$error_file" >&2
    rm -f "$error_file"
    return "$rc"
  fi
  rm -f "$error_file"
  jq -e 'select(type == "object" and (.enable_status_check | type == "boolean") and (.status_check_contexts | type == "array") and all(.status_check_contexts[]; type == "string"))' <<<"$result"
}
required_signoff_contexts() {
  protection "$1" | jq -r 'select(. != null and .enable_status_check) | .status_check_contexts[] | select(. == "signoff" or startswith("signoff/"))'
}
assert_unchanged() {
  local changes
  changes="$(git status --porcelain)" || die "cannot inspect working tree"
  [ "$(git rev-parse HEAD)" = "$1" ] || die "HEAD changed while checking; refusing signoff"
  [ -z "$changes" ] || die "uncommitted changes; commit before signing off"
}
assert_publishable() {
  local sha="$1" branch remote ref published
  assert_unchanged "$sha"
  branch="$(git symbolic-ref --quiet --short HEAD)" || die "detached HEAD; check out a pushed branch"
  remote="$(git config --get "branch.$branch.remote")" || die "no upstream; push with --set-upstream first"
  ref="$(git config --get "branch.$branch.merge")" || die "no upstream branch"
  [ "$remote" != . ] || die "upstream must be a remote repository"
  published="$(git ls-remote --exit-code "$remote" "$ref")" || die "cannot verify the published branch"
  [ "${published%%$'\t'*}" = "$sha" ] || die "remote branch does not point to HEAD; push first"
  api "repos/{owner}/{repo}/git/commits/$sha" | jq -e --arg sha "$sha" '.sha == $sha' >/dev/null \
    || die "commit is not present in the selected Gitea repository"
  assert_unchanged "$sha"
}
publish_status() {
  local payload
  payload="$(jq -n --arg c "$2" --arg s "$3" --arg d "$4" '{context:$c, state:$s, description:$d}')"
  printf '%s' "$payload" | api -X POST "repos/{owner}/{repo}/statuses/$1" --input - >/dev/null
}
cmd_create() {
  local force=false sha context who
  if [ "${1:-}" = -f ]; then force=true; shift; fi
  [ "$#" -le 1 ] || die "expected at most one context; use run [context] -- COMMAND for local checks"
  sha="$(git rev-parse HEAD)"
  context="$(resolve_context "${1:-}")"
  $force || assert_publishable "$sha"
  who="$(api user | jq -er .login)"
  $force || assert_unchanged "$sha"
  publish_status "$sha" "$context" success "Signed off by $who"
  echo "$SYM_SUCCESS $context on ${sha:0:8}"
}
cmd_run() {
  context=signoff
  if [ "${1:-}" != -- ]; then context="$(resolve_context "${1:-}")"; [ "$#" -gt 0 ] && shift; fi
  [ "${1:-}" = -- ] || die "usage: run [context] -- COMMAND [ARGS...]"
  shift
  [ "$#" -gt 0 ] || die "run needs a command"
  sha="$(git rev-parse HEAD)"
  assert_publishable "$sha"
  publish_status "$sha" "$context" pending "Local checks running"
  pending=true
  child=""
  # shellcheck disable=SC2317 # Invoked through the EXIT trap.
  finish() {
    rc=$?
    trap - EXIT
    if $pending; then
      publish_status "$sha" "$context" failure "Local checks failed or interrupted" || echo "gitea-signoff: could not publish failure; status may remain pending" >&2
    fi
    exit "$rc"
  }
  # shellcheck disable=SC2317 # Invoked through signal traps.
  stop() { [ -z "$child" ] || kill -TERM -- "-$child" 2>/dev/null || true; exit "$1"; }
  trap finish EXIT
  trap 'stop 130' INT
  trap 'stop 143' TERM
  trap 'stop 129' HUP
  set -m
  "$@" &
  child=$!
  rc=0
  wait "$child" || rc=$?
  child=""
  [ "$rc" -eq 0 ] || exit "$rc"
  assert_publishable "$sha"
  publish_status "$sha" "$context" success "Local checks passed"
  pending=false
  echo "$SYM_SUCCESS $context on ${sha:0:8}"
  exit 0
}
cmd_install() {
  [ "$#" -le 2 ] || die "usage: install [branch] [context]"
  local branch context existing payload
  branch="${1:-$(default_branch)}"
  context="$(resolve_context "${2:-}")"
  existing="$(protection "$branch")"
  if [ "$existing" = null ]; then
    payload="$(jq -n --arg b "$branch" --arg c "$context" '{rule_name:$b, branch_name:$b, enable_status_check:true, status_check_contexts:[$c]}')"
    printf '%s' "$payload" | api -X POST 'repos/{owner}/{repo}/branch_protections' --input - >/dev/null
  else
    payload="$(jq -c --arg c "$context" '{enable_status_check:true, status_check_contexts:((.status_check_contexts + [$c]) | unique)}' <<<"$existing")"
    printf '%s' "$payload" | api -X PATCH "repos/{owner}/{repo}/branch_protections/$(branch_path "$branch")" --input - >/dev/null
  fi
  echo "$SYM_SUCCESS require $context on $branch"
}
cmd_uninstall() {
  [ "$#" -le 2 ] || die "usage: uninstall [branch] [context]"
  local branch context existing payload
  branch="${1:-$(default_branch)}"
  context="$(resolve_context "${2:-}")"
  existing="$(protection "$branch")"
  [ "$existing" != null ] || { echo "no protection on $branch"; return; }
  payload="$(jq -c --arg c "$context" '(.status_check_contexts - [$c]) as $ctx | {enable_status_check:(.enable_status_check and ($ctx | length > 0)), status_check_contexts:$ctx}' <<<"$existing")"
  printf '%s' "$payload" | api -X PATCH "repos/{owner}/{repo}/branch_protections/$(branch_path "$branch")" --input - >/dev/null
  echo "$SYM_SUCCESS no longer require $context on $branch"
}
cmd_check() {
  [ "$#" -le 1 ] || die "usage: check [branch]"
  local branch required
  branch="${1:-$(default_branch)}"
  required="$(required_signoff_contexts "$branch")"
  [ -n "$required" ] || { echo "$SYM_FAILURE signoff not required on $branch"; return 1; }
  echo "$SYM_SUCCESS signoff required on $branch"
}
cmd_status() {
  [ "$#" -le 1 ] || die "usage: status [branch]"
  local branch sha required statuses ctx state rc=0
  branch="${1:-$(default_branch)}"
  sha="$(git rev-parse HEAD)"
  required="$(required_signoff_contexts "$branch")"
  [ -n "$required" ] || { echo "no signoff required on $branch"; return; }
  statuses="$(api --paginate "repos/{owner}/{repo}/statuses/$sha" | jq -s 'add | sort_by(.id) | reverse')"
  while IFS= read -r ctx; do
    state="$(jq -r --arg c "$ctx" 'first(.[] | select(.context == $c) | .status) // "pending"' <<<"$statuses")"
    [ "$state" = success ] || rc=1
    echo "$(state_symbol "$state") $ctx"
  done <<<"$required"
  return "$rc"
}
usage() {
  cat <<'HELP'
gitea-signoff: human signoff and local CI commit statuses

Usage:
  gitea-signoff [-f] [context]
  gitea-signoff run [context] -- COMMAND [ARGS...]
  gitea-signoff install [branch] [context]
  gitea-signoff uninstall [branch] [context]
  gitea-signoff check [branch]
  gitea-signoff status [branch]
  gitea-signoff version

Global options (before command): --host URL, --user NAME, --repo OWNER/REPO-or-URL
Authenticate with gt auth login. Run refuses dirty, detached or unpublished HEAD.
-f applies only to human signoff; it cannot bypass checks in run.
HELP
}
main() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --host|--user|--repo)
        [ "$#" -ge 2 ] || die "$1 needs a value"
        case "$1" in --host) HOST="$2" ;; --user) USER_NAME="$2" ;; --repo) REPO="$2" ;; esac
        shift 2 ;;
      *) break ;;
    esac
  done
  local cmd="${1:-}"; [ "$#" -eq 0 ] || shift
  case "$cmd" in help|-h|--help) usage; return ;; version|--version) echo "gitea-signoff $VERSION"; return ;; esac
  require_tools
  pin_repository
  case "$cmd" in
    ''|create) cmd_create "$@" ;;
    run) cmd_run "$@" ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    check) cmd_check "$@" ;;
    status) cmd_status "$@" ;;
    -f) cmd_create -f "$@" ;;
    -*) die "unknown option: $cmd" ;;
    *) cmd_create "$cmd" "$@" ;;
  esac
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
